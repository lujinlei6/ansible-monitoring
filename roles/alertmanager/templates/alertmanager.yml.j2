# ============================================================
# Alertmanager 主配置（Ansible 渲染 → /etc/alertmanager/alertmanager.yml）
# 处理顺序：去重 → 分组 → 抑制 → 静默 → 路由 → 通知
# 项目二新增：所有告警在发邮件之外，额外投递到 AI 服务（aiops-webhook）做根因诊断
# 注意 1：文件中 {% raw %}{{ ... }}{% endraw %} 为 Go 模板语法，Ansible 渲染时原样保留
# 注意 2：Ansible 默认开启 trim_blocks 会删除块标签后的换行，html: 行与其后
#         headers: 行之间必须保留一个空行，否则渲染出的 YAML 会被拼行报错
# 注意 3：continue: true 是关键——没有它，critical 告警只会发邮件、不会进入 AI 兜底路由
# ============================================================

# ---------- 全局 ----------
global:
  resolve_timeout: 5m            # 5 分钟收不到告警更新则标记为已恢复
  # ---------- 邮件发送参数 ----------
  smtp_smarthost: '{{ smtp_smarthost }}'
  smtp_from: '{{ smtp_from }}'
  smtp_auth_username: '{{ smtp_from }}'
  smtp_auth_password: '{{ smtp_auth_password }}'   # 邮箱“SMTP 授权码”，不是登录密码
  smtp_require_tls: false                          # 465 端口为隐式 SSL，无需 STARTTLS

# ---------- 自定义邮件模板 ----------
templates:
  - '/etc/alertmanager/templates/*.tmpl'

# ---------- 路由：邮件分级 + 全量投递 AI ----------
route:
  receiver: 'email-warning'                      # 默认接收器
  group_by: ['alertname', 'node']                # 同告警+同节点合并为一封
  group_wait: 30s                                # 新告警组等待 30s 聚合后发送
  group_interval: 5m                             # 同组追加告警的发送间隔
  repeat_interval: 4h                            # 未恢复告警 4 小时提醒一次（降噪关键）
  routes:
    # 1) P1 严重：10 秒聚合、1 小时重发；continue 让告警继续匹配后续兄弟路由 → 同时送 AI
    - matchers:
        - severity="critical"
      receiver: 'email-critical'
      group_wait: 10s
      repeat_interval: 1h
      continue: true

    # 2) P2 警告：走默认聚合策略；continue 同样下探到 AI 路由
    - matchers:
        - severity="warning"
      receiver: 'email-warning'
      continue: true

    # 3) 兜底：所有告警都送 AI 服务（无 matchers 会匹配全部，必须放最后）
    - receiver: 'aiops-webhook'
      group_wait: 10s
      group_interval: 1m
      repeat_interval: 4h

# ---------- 接收器 ----------
receivers:
  - name: 'email-critical'
    email_configs:
      - to: '{{ alert_email_to }}'
        send_resolved: true                      # 恢复时再发一封恢复邮件
        html: {% raw %}'{{ template "email.custom.html" . }}'{% endraw %}

        headers:
          Subject: {% raw %}'[P1严重][{{ .Status | toUpper }}] {{ .CommonLabels.alertname }} @ {{ .CommonLabels.node }}'{% endraw %}

  - name: 'email-warning'
    email_configs:
      - to: '{{ alert_email_to }}'
        send_resolved: true
        html: {% raw %}'{{ template "email.custom.html" . }}'{% endraw %}

        headers:
          Subject: {% raw %}'[P2警告][{{ .Status | toUpper }}] {{ .CommonLabels.alertname }} @ {{ .CommonLabels.node }}'{% endraw %}

  # AI 服务 Webhook：POST 到 FastAPI /api/v1/alerts
  - name: 'aiops-webhook'
    webhook_configs:
      - url: '{{ aiops_webhook_url }}'
        send_resolved: true
        max_alerts: 0

# ---------- 抑制规则（告警收敛核心）----------
inhibit_rules:
  # 规则一：同一节点出现 critical 告警时，压制该节点上的 warning 告警
  - source_matchers:
      - severity="critical"
    target_matchers:
      - severity="warning"
    equal: ['node']

  # 规则二：节点宕机时，压制该节点上"派生出来的"组件不可达告警（防告警风暴）
  - source_matchers:
      - alertname="NodeDown"
    target_matchers:
      - alertname=~"KubeletDown|KubeAPIServerDown|KubeSchedulerDown|KubeControllerManagerDown|EtcdDown"
    equal: ['node']
