          "expr": "(sum by(host)(rate(nginx_ingress_controller_requests{status=~\"5..\"}[5m])) or on(host) (sum by(host)(rate(nginx_ingress_controller_requests[5m])) * 0)) / sum by(host)(rate(nginx_ingress_controller_requests[5m]))",
