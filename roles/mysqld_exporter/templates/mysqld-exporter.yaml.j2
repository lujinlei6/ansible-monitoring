# ============================================================
# 由 Ansible 渲染并 kubectl apply
# 组件：mysqld_exporter v0.20.0（Secret + Deployment + NodePort Service）
# 注意：mysqld_exporter 0.16.0 起已移除 DATA_SOURCE_NAME 环境变量，
#       本模板使用新式参数：--mysqld.username / --mysqld.address + 密码环境变量
# ============================================================
apiVersion: v1
kind: Secret
metadata:
  name: mysqld-exporter-secret
  namespace: {{ exporter_namespace }}
type: Opaque
stringData:
  MYSQLD_EXPORTER_PASSWORD: "{{ mysql_exporter_password }}"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mysqld-exporter
  namespace: {{ exporter_namespace }}
  labels:
    app: mysqld-exporter
spec:
  replicas: 1
  selector:
    matchLabels:
      app: mysqld-exporter
  template:
    metadata:
      labels:
        app: mysqld-exporter
    spec:
      containers:
        - name: mysqld-exporter
          image: harbor.lab/monitoring/mysqld-exporter:v{{ mysqld_exporter_version }}
          args:
            - "--mysqld.username={{ mysql_exporter_user }}"
            - "--mysqld.address={{ mysql_host }}:{{ mysql_port }}"
          env:
            - name: MYSQLD_EXPORTER_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: mysqld-exporter-secret
                  key: MYSQLD_EXPORTER_PASSWORD
          ports:
            - name: metrics
              containerPort: 9104
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 200m
              memory: 128Mi
---
apiVersion: v1
kind: Service
metadata:
  name: mysqld-exporter
  namespace: {{ exporter_namespace }}
spec:
  type: NodePort
  selector:
    app: mysqld-exporter
  ports:
    - name: metrics
      port: 9104
      targetPort: 9104
      nodePort: {{ mysqld_exporter_nodeport }}
