    {
      "id": 4,
      "title": "诊断耗时 P95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by(le)(rate(aiops_diagnosis_duration_seconds_bucket[5m])))",
          "instant": false,
          "range": true,
          "legendFormat": "P95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "pluginVersion": "11.0.0"
    },
    {
      "id": 5,
      "title": "风险评分（按实例）",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by(instance)(aiops_risk_score)",
          "instant": false,
          "range": true,
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "pluginVersion": "11.0.0"
    },
    {
      "id": 6,
      "title": "最新事件表（MySQL）",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "aiops-mysql"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "aiops-mysql"
          },
          "format": "table",
          "rawSql": "SELECT created_at AS time, alertname, severity, status, instance FROM incidents ORDER BY created_at DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "pluginVersion": "11.0.0"
    },
    {
      "id": 7,
      "title": "最新诊断表（MySQL）",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "aiops-mysql"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "aiops-mysql"
          },
          "format": "table",
          "rawSql": "SELECT d.created_at AS time, i.alertname, d.risk_level, d.confidence, d.source, d.root_cause , d.fix_plan FROM diagnoses d JOIN incidents i ON d.incident_id=i.id ORDER BY d.created_at DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "pluginVersion": "11.0.0"
    },
    {
      "id": 8,
      "title": "预测曲线 · $metric @ $instance（ARIMA 未来 24h，% ）",
      "type": "timeseries",
      "datasource": {
        "type": "mysql",
        "uid": "aiops-mysql"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 39
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "aiops-mysql"
          },
          "format": "time_series",
          "rawSql": "SELECT target_time AS time, predicted_value AS \"预测值(估算)\", upper_bound AS \"上界(+2xRMSE)\", lower_bound AS \"下界(-2xRMSE)\" FROM predictions WHERE metric = '$metric' AND instance = '$instance' ORDER BY target_time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "下界(-2xRMSE)"
            },
            "properties": [
              {
                "id": "custom.fillBelowTo",
                "value": "上界(+2xRMSE)"
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.fillOpacity",
                "value": 14
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "上界(+2xRMSE)"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "预测值(估算)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "pluginVersion": "11.0.0",
      "timeFrom": "now-1h",
      "timeTo": "now+24h"
    },
    {
      "id": 9,
      "title": "预测误差（MySQL）",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "aiops-mysql"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 39
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "aiops-mysql"
          },
          "format": "table",
          "rawSql": "SELECT MAX(created_at) AS time, metric, instance, model, MAX(mae) AS mae, MAX(rmse) AS rmse, MAX(mape) AS mape FROM predictions GROUP BY metric, instance, model ORDER BY time DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "pluginVersion": "11.0.0"
    }
  ],
